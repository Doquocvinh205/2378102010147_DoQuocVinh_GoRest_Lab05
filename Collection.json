{
  "info": {
    "_postman_id": "71df2c90-6c3d-4193-abef-6cf1ed1d1013",
    "name": "2378102010147_DoQuocVinh_GoRest",
    "description": "Lab 05 - Kiểm thử API GoRest. Chạy kèm users.csv (3 iterations). Thứ tự thực thi mỗi vòng: 1 -> 2 -> 3 -> 5 -> 6 -> 4 -> 7.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "59052417",
    "_collection_link": "https://go.postman.co/collection/59052417-71df2c90-6c3d-4193-abef-6cf1ed1d1013?source=collection_link"
  },
  "item": [
    {
      "name": "Positive_Cases",
      "item": [
        {
          "name": "1. POST User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Đọc dữ liệu từ users.csv (Data-Driven). Nếu chạy lẻ (không có file) thì dùng giá trị mặc định.",
                  "const d = pm.iterationData;",
                  "const stamp = Date.now();",
                  "pm.variables.set('u_name',   d.get('name')   || 'Test User ' + stamp);",
                  "pm.variables.set('u_gender', d.get('gender') || 'male');",
                  "pm.variables.set('u_email',  d.get('email')  || 'test.' + stamp + '@example.com');",
                  "pm.variables.set('u_status', d.get('status') || 'active');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code là 201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Response có id', () => pm.expect(json).to.have.property('id'));",
                  "pm.test('Dữ liệu trả về khớp dữ liệu gửi đi', () => {",
                  "  pm.expect(json.email).to.eql(pm.variables.get('u_email'));",
                  "  pm.expect(json.name).to.eql(pm.variables.get('u_name'));",
                  "});",
                  "",
                  "// API Chaining: lưu id và email để các request sau dùng lại",
                  "if (json.id) {",
                  "  pm.environment.set('userId', json.id);",
                  "  pm.environment.set('userEmail', json.email);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{u_name}}\",\n  \"gender\": \"{{u_gender}}\",\n  \"email\": \"{{u_email}}\",\n  \"status\": \"{{u_status}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2. GET User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code là 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('id khớp với user vừa tạo', () => {",
                  "  pm.expect(String(pm.response.json().id)).to.eql(String(pm.environment.get('userId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/{{userId}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "3. PATCH User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code là 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status đã đổi thành inactive', () => pm.expect(pm.response.json().status).to.eql('inactive'));",
                  "",
                  "// Thứ tự chạy: 3 -> 5 -> 6 -> 4 -> 7 (xem ghi chú trong báo cáo)",
                  "postman.setNextRequest('5. POST User - No Token');"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"inactive\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/users/{{userId}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "4. DELETE User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code là 204 No Content', () => pm.response.to.have.status(204));",
                  "pm.test('Body rỗng', () => pm.expect(pm.response.text()).to.eql(''));",
                  "postman.setNextRequest('7. GET User - After Delete');"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/{{userId}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Negative_Cases",
      "item": [
        {
          "name": "5. POST User - No Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code là 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('Có thông báo lỗi xác thực', () => pm.expect(pm.response.text()).to.not.be.empty);",
                  "postman.setNextRequest('6. POST User - Duplicate Email');"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"No Token User\",\n  \"gender\": \"male\",\n  \"email\": \"notoken.{{$timestamp}}@example.com\",\n  \"status\": \"active\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "response": []
        },
        {
          "name": "6. POST User - Duplicate Email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code là 422 Unprocessable Entity', () => pm.response.to.have.status(422));",
                  "pm.test('Lỗi nằm ở trường email', () => {",
                  "  const errs = pm.response.json();",
                  "  pm.expect(errs.some(e => e.field === 'email')).to.be.true;",
                  "});",
                  "postman.setNextRequest('4. DELETE User');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Duplicate User\",\n  \"gender\": \"male\",\n  \"email\": \"{{userEmail}}\",\n  \"status\": \"active\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "response": []
        },
        {
          "name": "7. GET User - After Delete",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code là 404 Not Found (user đã bị xóa)', () => pm.response.to.have.status(404));",
                  "// Dọn biến để lần lặp sau (iteration kế tiếp) bắt đầu sạch",
                  "pm.environment.unset('userId');",
                  "pm.environment.unset('userEmail');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/{{userId}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  }
}